.git
.github
.agents
.aws
.claude
.codex
.gemini
.ssh
/CLAUDE.local.md
/.idea
/.vscode
tests

# Local dependencies and generated files. Keep public/vendor (published assets).
/vendor
**/node_modules
/public/build
/public/hot
/public/storage
/bootstrap/cache
**/.cache
**/.npm
**/.phpstan
**/.phpunit.cache
**/.phpunit.result.cache
**/*.log

# Local configuration, credential files and install state.
**/.env
**/.env.*
**/.npmrc
**/.netrc
**/auth.json
**/credentials.json
**/secrets
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.sqlite
**/*.sqlite-*
**/*.sql
**/*.sql.gz
**/.installed
/app.env
/rconfig-vhost.local.conf
docker-compose*.yml

# Ship only the bundled storage templates. The image recreates directories.
/storage/**
!/storage/app/rconfig/templates/default.yml
!/storage/app/rconfig/templates/ios-ssh-enable.yml
!/storage/app/rconfig/templates/ios-ssh-noenable.yml
!/storage/app/rconfig/templates/ios-telnet-enable.yml
!/storage/app/rconfig/templates/ios-telnet-noenable.yml
